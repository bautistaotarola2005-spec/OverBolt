<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClashManager.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="740" d:DesignHeight="440"
             x:Class="ClashManager.Views.RosterView"
             x:DataType="vm:RosterViewModel">

    <Design.DataContext>
        <vm:RosterViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,3">
            <TextBlock Grid.Column="0" Classes="titulo" Text="Roster" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <TextBlock Text="Equipo" FontSize="12" FontWeight="Bold" Foreground="#F97316"
                           VerticalAlignment="Center" />
                <TextBox Text="{Binding NombreEquipo}" Watermark="Nombre del equipo"
                         Width="215" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1" Classes="subtitulo" Text="{Binding Composicion}" Margin="0,0,0,18" />

        <!-- Nota: las tarjetas de titulares estan escritas a mano por indice (Jugadores[0]..[3])
             como paso intermedio, mas dos slots libres hasta completar el 6v6. Cuando agreguemos
             alta/baja de jugadores esto vuelve a ser un ItemsControl sobre la coleccion completa. -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
            <UniformGrid Columns="6" MinWidth="720">

                <Border Classes="card" Padding="10" Margin="5" VerticalAlignment="Stretch">
                    <Grid>
                        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center">
                            <Border Classes="badge" Padding="7,2" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Jugadores[0].Rol}" FontSize="10" FontWeight="Bold" Foreground="#10101A" />
                            </Border>
                            <TextBlock Text="{Binding Jugadores[0].BattleTag}" FontSize="16" FontWeight="Bold"
                                       Foreground="White" TextAlignment="Center" TextWrapping="Wrap" Margin="0,14,0,4" />
                            <TextBlock Text="{Binding Jugadores[0].Rango}" FontSize="11" Foreground="#9CA3AF"
                                       TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Background="#F97316" CornerRadius="11" Width="22" Height="22"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,2,2"
                                IsVisible="{Binding Jugadores[0].EsCapitan}">
                            <TextBlock Text="C" FontSize="12" FontWeight="Bold" Foreground="#10101A"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <Border Classes="card" Padding="10" Margin="5" VerticalAlignment="Stretch">
                    <Grid>
                        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center">
                            <Border Classes="badge" Padding="7,2" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Jugadores[1].Rol}" FontSize="10" FontWeight="Bold" Foreground="#10101A" />
                            </Border>
                            <TextBlock Text="{Binding Jugadores[1].BattleTag}" FontSize="16" FontWeight="Bold"
                                       Foreground="White" TextAlignment="Center" TextWrapping="Wrap" Margin="0,14,0,4" />
                            <TextBlock Text="{Binding Jugadores[1].Rango}" FontSize="11" Foreground="#9CA3AF"
                                       TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Background="#F97316" CornerRadius="11" Width="22" Height="22"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,2,2"
                                IsVisible="{Binding Jugadores[1].EsCapitan}">
                            <TextBlock Text="C" FontSize="12" FontWeight="Bold" Foreground="#10101A"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <Border Classes="card" Padding="10" Margin="5" VerticalAlignment="Stretch">
                    <Grid>
                        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center">
                            <Border Classes="badge" Padding="7,2" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Jugadores[2].Rol}" FontSize="10" FontWeight="Bold" Foreground="#10101A" />
                            </Border>
                            <TextBlock Text="{Binding Jugadores[2].BattleTag}" FontSize="16" FontWeight="Bold"
                                       Foreground="White" TextAlignment="Center" TextWrapping="Wrap" Margin="0,14,0,4" />
                            <TextBlock Text="{Binding Jugadores[2].Rango}" FontSize="11" Foreground="#9CA3AF"
                                       TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Background="#F97316" CornerRadius="11" Width="22" Height="22"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,2,2"
                                IsVisible="{Binding Jugadores[2].EsCapitan}">
                            <TextBlock Text="C" FontSize="12" FontWeight="Bold" Foreground="#10101A"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <Border Classes="card" Padding="10" Margin="5" VerticalAlignment="Stretch">
                    <Grid>
                        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center">
                            <Border Classes="badge" Padding="7,2" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Jugadores[3].Rol}" FontSize="10" FontWeight="Bold" Foreground="#10101A" />
                            </Border>
                            <TextBlock Text="{Binding Jugadores[3].BattleTag}" FontSize="16" FontWeight="Bold"
                                       Foreground="White" TextAlignment="Center" TextWrapping="Wrap" Margin="0,14,0,4" />
                            <TextBlock Text="{Binding Jugadores[3].Rango}" FontSize="11" Foreground="#9CA3AF"
                                       TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Background="#F97316" CornerRadius="11" Width="22" Height="22"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,2,2"
                                IsVisible="{Binding Jugadores[3].EsCapitan}">
                            <TextBlock Text="C" FontSize="12" FontWeight="Bold" Foreground="#10101A"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <Border Classes="vacante" Margin="5" VerticalAlignment="Stretch">
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="+" FontSize="30" FontWeight="Bold" Foreground="#38BDF8"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="libre" FontSize="10" Foreground="#6B7280"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Classes="vacante" Margin="5" VerticalAlignment="Stretch">
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="+" FontSize="30" FontWeight="Bold" Foreground="#38BDF8"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="libre" FontSize="10" Foreground="#6B7280"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

            </UniformGrid>
        </ScrollViewer>

    </Grid>

</UserControl>
