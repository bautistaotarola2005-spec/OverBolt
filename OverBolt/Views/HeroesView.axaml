<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OverBolt.ViewModels"
             xmlns:models="using:OverBolt.Models"
             xmlns:conv="using:OverBolt.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="740" d:DesignHeight="460"
             x:Class="OverBolt.Views.HeroesView"
             x:DataType="vm:HeroesViewModel">

    <Design.DataContext>
        <vm:HeroesViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*">

        <TextBlock Grid.Row="0" Classes="titulo" Text="Héroes" Margin="0,0,0,3" />
        <TextBlock Grid.Row="1" Classes="subtitulo"
                   Text="Los tres héroes de mayor nivel de cada jugador" Margin="0,0,0,18" />

        <ScrollViewer Grid.Row="2">
            <StackPanel Spacing="10">

                <ItemsControl ItemsSource="{Binding Grupos}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="models:GrupoHeroes">
                            <Border Classes="card" Padding="18" Margin="0,0,0,10">
                                <Grid ColumnDefinitions="168,*">

                                    <StackPanel Grid.Column="0" Spacing="7" VerticalAlignment="Center"
                                                Margin="0,0,16,0">
                                        <TextBlock Text="{Binding BattleTag}" FontSize="17" FontWeight="Bold"
                                                   Foreground="#F97316" />
                                        <Border Classes="badge" Padding="7,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Rol}" FontSize="10" FontWeight="Bold"
                                                       Foreground="#10101A" />
                                        </Border>
                                    </StackPanel>

                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Principales}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="3" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="models:HeroeDeJugador">
                                                <Border Classes="tile" Padding="0" Margin="4"
                                                        ClipToBounds="True">
                                                    <StackPanel>

                                                        <Panel Height="92">
                                                            <Border Background="#20202E">
                                                                <TextBlock Text="{Binding Inicial}"
                                                                           FontSize="32" FontWeight="Bold"
                                                                           Foreground="#3A3A50"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                            </Border>
                                                            <Image Stretch="UniformToFill"
                                                                   Source="{Binding Retrato,
                                                                       Converter={x:Static conv:RutaAImagen.Instancia}}" />
                                                        </Panel>

                                                        <StackPanel Margin="11,9,11,11" Spacing="3">
                                                            <TextBlock Text="{Binding Nombre}" FontSize="13"
                                                                       FontWeight="Bold" Foreground="White"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding NivelTexto}" FontSize="12"
                                                                       FontWeight="Bold" Foreground="#38BDF8" />
                                                        </StackPanel>

                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Composiciones" FontSize="17" FontWeight="Bold" Foreground="White"
                           Margin="0,10,0,0" />
                <TextBlock Classes="subtitulo" FontSize="12" Margin="0,0,0,4"
                           Text="Dos de referencia del meta y una armada con el pool propio del equipo" />

                <ItemsControl ItemsSource="{Binding Composiciones}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="models:ComposicionEquipo">
                            <Border Classes="card" Padding="17" Margin="5" VerticalAlignment="Stretch">
                                <StackPanel Spacing="11">

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Nombre}" FontSize="15" FontWeight="Bold"
                                                   Foreground="White" VerticalAlignment="Center" />
                                        <Border CornerRadius="5" Padding="7,2" VerticalAlignment="Center"
                                                Background="#38BDF8" IsVisible="{Binding !EsSugerida}">
                                            <TextBlock Text="{Binding Tipo}" FontSize="9" FontWeight="Bold"
                                                       Foreground="#10101A" />
                                        </Border>
                                        <Border CornerRadius="5" Padding="7,2" VerticalAlignment="Center"
                                                Background="#F97316" IsVisible="{Binding EsSugerida}">
                                            <TextBlock Text="{Binding Tipo}" FontSize="9" FontWeight="Bold"
                                                       Foreground="#10101A" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Afinidad}" FontSize="11" Foreground="#9CA3AF"
                                               TextWrapping="Wrap" />

                                    <Border Classes="tile" Padding="11,10">
                                        <StackPanel Spacing="9">

                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Tanques" FontSize="9" Foreground="#6B7280" />
                                                <ItemsControl ItemsSource="{Binding Tanques}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="models:Heroe">
                                                            <StackPanel Orientation="Horizontal" Spacing="7"
                                                                        Margin="0,0,0,3">
                                                                <Panel Width="24" Height="24">
                                                                    <Border Background="#26263A" CornerRadius="12">
                                                                        <TextBlock Text="{Binding Inicial}" FontSize="11"
                                                                                   FontWeight="Bold" Foreground="#6B7280"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <Border CornerRadius="12" ClipToBounds="True">
                                                                        <Image Stretch="UniformToFill"
                                                                               Source="{Binding Retrato,
                                                                                   Converter={x:Static conv:RutaAImagen.Instancia}}" />
                                                                    </Border>
                                                                </Panel>
                                                                <TextBlock Text="{Binding Nombre}" FontSize="12"
                                                                           Foreground="White"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Daño" FontSize="9" Foreground="#6B7280" />
                                                <ItemsControl ItemsSource="{Binding Danos}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="models:Heroe">
                                                            <StackPanel Orientation="Horizontal" Spacing="7"
                                                                        Margin="0,0,0,3">
                                                                <Panel Width="24" Height="24">
                                                                    <Border Background="#26263A" CornerRadius="12">
                                                                        <TextBlock Text="{Binding Inicial}" FontSize="11"
                                                                                   FontWeight="Bold" Foreground="#6B7280"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <Border CornerRadius="12" ClipToBounds="True">
                                                                        <Image Stretch="UniformToFill"
                                                                               Source="{Binding Retrato,
                                                                                   Converter={x:Static conv:RutaAImagen.Instancia}}" />
                                                                    </Border>
                                                                </Panel>
                                                                <TextBlock Text="{Binding Nombre}" FontSize="12"
                                                                           Foreground="White"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Soportes" FontSize="9" Foreground="#6B7280" />
                                                <ItemsControl ItemsSource="{Binding Soportes}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="models:Heroe">
                                                            <StackPanel Orientation="Horizontal" Spacing="7"
                                                                        Margin="0,0,0,3">
                                                                <Panel Width="24" Height="24">
                                                                    <Border Background="#26263A" CornerRadius="12">
                                                                        <TextBlock Text="{Binding Inicial}" FontSize="11"
                                                                                   FontWeight="Bold" Foreground="#6B7280"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <Border CornerRadius="12" ClipToBounds="True">
                                                                        <Image Stretch="UniformToFill"
                                                                               Source="{Binding Retrato,
                                                                                   Converter={x:Static conv:RutaAImagen.Instancia}}" />
                                                                    </Border>
                                                                </Panel>
                                                                <TextBlock Text="{Binding Nombre}" FontSize="12"
                                                                           Foreground="White"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="{Binding Descripcion}" FontSize="11" Foreground="#D1D5DB"
                                               TextWrapping="Wrap" />

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

    </Grid>

</UserControl>
