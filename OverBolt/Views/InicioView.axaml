<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OverBolt.ViewModels"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="740" d:DesignHeight="460"
             x:Class="OverBolt.Views.InicioView"
             x:DataType="vm:InicioViewModel">

    <Design.DataContext>
        <vm:InicioViewModel />
    </Design.DataContext>

    <StackPanel Spacing="22" VerticalAlignment="Center" MaxWidth="620">

        <svg:Svg Path="/Assets/logo.svg" Width="104" Height="104"
                 Stretch="Uniform" HorizontalAlignment="Center" />

        <Border Classes="card" Padding="26">
            <StackPanel Spacing="7" HorizontalAlignment="Center">
                <TextBlock Text="Próximo torneo" FontSize="13" FontWeight="Bold" Foreground="#38BDF8"
                           HorizontalAlignment="Center" />
                <TextBlock Text="19 de septiembre, 17:00" FontSize="13" Foreground="#9CA3AF"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding TiempoRestante}" FontSize="33" FontWeight="Bold"
                           Foreground="#F97316" HorizontalAlignment="Center" Margin="0,10,0,0" />
            </StackPanel>
        </Border>

        <Border Classes="card" Padding="22">
            <StackPanel Spacing="7">
                <TextBlock Text="Novedades del parche" FontSize="13" FontWeight="Bold"
                           Foreground="#38BDF8" />
                <TextBlock Text="{Binding NotasParche}" FontSize="13" TextWrapping="Wrap"
                           Foreground="#E5E7EB" LineHeight="20" />
            </StackPanel>
        </Border>

    </StackPanel>

</UserControl>
